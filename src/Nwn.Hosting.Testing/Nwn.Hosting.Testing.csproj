<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Nwn.Hosting.Testing</RootNamespace>
    <Description>Test doubles and retired-generation assertions for code built on Nwn.Hosting: a stand-in engine thread, recording and callback-driving native bindings, and a generic-virtual-dispatch cache inspector. No test-framework dependency.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nwn.Hosting/Nwn.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../licenses/NWN-Hosting-MIT.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
